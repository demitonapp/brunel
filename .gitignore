.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Build artefacts. The spec is the source of truth; these are outputs.
renders/
*.blend
*.blend1
# ...except the CC0 assets the harness BUILDS FROM. `*.blend` exists to keep
# render artefacts out; assets/ is source, and gen_figure refuses to build
# without it. Committing it silently ignored would break a fresh clone with an
# error about a missing file nobody deleted.
!assets/*.blend
blender_tx/
*.exr

.DS_Store

# Secrets. An API key must never be committable by accident: this repo publishes,
# and a key in history is disclosed the moment it is pushed. Kept out by pattern
# rather than by remembering.
.env
.env.*
!.env.example

# Research payload: third-party primary sources and downloaded text.
# ~119 MB of public-domain scans and downloaded runs. Kept locally for the
# fact ledger, deliberately not published.
/research/
